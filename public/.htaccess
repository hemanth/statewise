# Preserve HTTPS when Apache canonicalizes the app directory behind Cloudflare.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/fun/statewise$
  RewriteRule ^ https://h3manth.com/fun/statewise/ [R=301,L]
</IfModule>

# Statewise is a static app; all navigation happens within index.html.
DirectoryIndex index.html
Options -Indexes
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType video/mp4 .mp4

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
</IfModule>
